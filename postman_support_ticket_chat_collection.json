{
  "info": {
    "_postman_id": "a6e3f8da-0d45-4e5c-9a96-91b5a8211d3a",
    "name": "Darbiny - Support Ticket Chat Endpoints",
    "description": "Standalone collection for support ticket chat endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticket_id",
      "value": "uuid-here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get Ticket Messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/support-tickets/{{ticket_id}}/messages?limit=50",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "support-tickets",
            "{{ticket_id}}",
            "messages"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            }
          ]
        },
        "description": "Get paginated ticket messages ordered by oldest first."
      }
    },
    {
      "name": "Send Ticket Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"متابعة بخصوص المشكلة\",\n  \"status\": \"open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/support-tickets/{{ticket_id}}/messages",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "support-tickets",
            "{{ticket_id}}",
            "messages"
          ]
        },
        "description": "Send a message in ticket thread. `status` is optional and mainly for admin."
      }
    }
  ]
}
